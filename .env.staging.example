# ==============================================================================
# منصة يوم التبرع بالدم — ملف إعدادات بيئة التجريب المرجعي (.env.staging.example)
# Blood Donation Platform - Staging Environment Configuration Template
# ==============================================================================
# تنبيه أمني وتشغيلي (docs/08-setup-env.md §13 & docs/10-testing-security-deployment.md):
# 1. بيئة Staging تطابق الإنتاج في السلوك الصارم (APP_ENV=prod, COOKIE_SECURE=true, DOCS_ENABLED=false).
# 2. تستخدم بيئة Staging قاعدة بيانات منفصلة تمامًا وأسرارًا مستقلة عن التطوير والإنتاج.
# 3. البيانات في Staging وهمية فقط (ممنوع بيانات حقيقية).
# 4. لا تضع أسرارًا حقيقية في هذا الملف؛ انسخه إلى مدير الأسرار أو بيئة تشغيل Staging.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. عام ومفاتيح التشغيل (General & Feature Flags)
# ------------------------------------------------------------------------------
APP_ENV=prod
APP_TIMEZONE=Africa/Algiers
PUBLIC_BASE_URL=https://staging.bloodday.dz
DOCS_ENABLED=false
EMERGENCY_ENABLED=true
PLEDGES_ENABLED=true
EMERGENCY_MIN_DAYS_SINCE_DONATION=0
STATIC_DIR=./app/web/static
LOG_LEVEL=INFO
LOG_FORMAT=json
ERROR_REPORTING_DSN=

# ------------------------------------------------------------------------------
# 2. الأسرار (Cryptographic Secrets) — يجب توليدها عشوائيًا لبيئة Staging
# توليد SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(64))"
# توليد IP_HASH_SALT:
#   python -c "import secrets; print(secrets.token_hex(32))"
# توليد TOTP_ENCRYPTION_KEY (مفتاح Fernet):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ------------------------------------------------------------------------------
SECRET_KEY=GENERATE_64_BYTE_HEX_KEY_FOR_STAGING_ENVIRONMENT_ONLY_RANDOM_VALUE
TOTP_ENCRYPTION_KEY=GENERATE_FERNET_BASE64_KEY_32_BYTES_FOR_STAGING_ONLY=
IP_HASH_SALT=GENERATE_32_BYTE_HEX_KEY_FOR_STAGING_ENVIRONMENT_ONLY_SALT

# ------------------------------------------------------------------------------
# 3. قاعدة البيانات (Staging PostgreSQL - D-09, D-57)
# ------------------------------------------------------------------------------
# اتصال app_user لتشغيل خادم Staging (صلاحيات DML فقط بلا DDL)
DATABASE_URL=postgresql+psycopg://app_user:STAGING_APP_USER_SECURE_PASSWORD@staging-db.internal:5432/bloodday_staging

# اتصال app_migrator لتطبيق هجرات Alembic على Staging (صلاحيات DDL كاملة)
MIGRATION_DATABASE_URL=postgresql+psycopg://app_migrator:STAGING_MIGRATOR_SECURE_PASSWORD@staging-db.internal:5432/bloodday_staging

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_SSLMODE=require

# ------------------------------------------------------------------------------
# 4. الجلسات والمصادقة (Sessions & Security)
# ------------------------------------------------------------------------------
COOKIE_SECURE=true
COOKIE_NAME=__Host-session
SESSION_IDLE_SUPERVISOR_MIN=240
SESSION_ABSOLUTE_SUPERVISOR_MIN=840
SESSION_IDLE_ADMIN_MIN=30
SESSION_ABSOLUTE_ADMIN_MIN=480
REAUTH_WINDOW_MIN=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_BASE_MIN=15
LOGIN_LOCK_MAX_MIN=60
INVITE_TTL_HOURS=72
RESET_TTL_MIN=60
TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
ALLOWED_ORIGINS=https://staging.bloodday.dz

# ------------------------------------------------------------------------------
# 5. محدد المعدل (Rate Limiting)
# ------------------------------------------------------------------------------
RATE_LIMIT_BACKEND=memory
RATE_PLEDGE_PER_HOUR=20
RATE_EMERGENCY_LIST_PER_HOUR=60
RATE_EMERGENCY_REVEAL_PER_HOUR=10
RATE_FORGOT_PER_HOUR=5
RATE_LOGIN_PER_15MIN=10

# ------------------------------------------------------------------------------
# 6. التخزين والصور (Storage & Photos)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/staging_uploads
STORAGE_PUBLIC_BASE_URL=/media
MAX_UPLOAD_BYTES=5242880
IMAGE_MAX_SIDE_PX=1600
IMAGE_MAX_PIXELS=40000000

# ------------------------------------------------------------------------------
# 7. البريد (Mailer) — في Staging يُربط بـ SMTP تجريبي أو Mailpit
# ------------------------------------------------------------------------------
MAIL_BACKEND=smtp
SMTP_HOST=smtp.staging-mail.internal
SMTP_PORT=587
SMTP_USER=staging-mailer
SMTP_PASSWORD=STAGING_SMTP_SECURE_PASSWORD
SMTP_TLS=true
MAIL_FROM=noreply@staging.bloodday.dz

# ------------------------------------------------------------------------------
# 8. الاحتفاظ والخصوصية (Retention & Privacy)
# ------------------------------------------------------------------------------
RETENTION_DAYS=365
REVEAL_LOG_RETENTION_DAYS=7
