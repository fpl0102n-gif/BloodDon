# ==============================================================================
# منصة يوم التبرع بالدم — ملف الأوامر واختصارات التطوير (Makefile)
# Mapped to: CLAUDE.md §4 & docs/08-setup-env.md §9.3
# ==============================================================================

.PHONY: help setup db-up db-down migrate seed run test test-critical lint audit check

# ------------------------------------------------------------------------------
# الهدف الافتراضي: عرض قائمة الأوامر المتاحة
# ------------------------------------------------------------------------------
help:
	@echo "================================================================="
	@echo "  منصة يوم التبرع بالدم - أوامر التطوير والتحقق"
	@echo "================================================================="
	@echo "  make setup          تثبيت الاعتمادات وتجهيز ملف .env"
	@echo "  make db-up          تشغيل حاويات قواعد البيانات ومصيدة البريد"
	@echo "  make db-down        إيقاف الحاويات"
	@echo "  make migrate        تطبيق هجرات Alembic على قاعدة البيانات"
	@echo "  make seed           إدخال البيانات التجريبية للتطوير"
	@echo "  make run            تشغيل خادم التطوير المحلي (Uvicorn)"
	@echo "  make test           تشغيل كل الاختبارات (Pytest)"
	@echo "  make test-critical  تشغيل الاختبارات الحرجة فقط (علامة critical)"
	@echo "  make lint           فحص الكود والأسلوب (Ruff + Mypy)"
	@echo "  make audit          فحص ثغرات الاعتمادات (pip-audit)"
	@echo "  make check          فحص الجودة الشامل (lint + test)"
	@echo "================================================================="

# ------------------------------------------------------------------------------
# إعداد البيئة والاعتمادات
# ------------------------------------------------------------------------------
setup:
	uv sync
	@if [ ! -f .env ]; then cp .env.example .env; echo "Created .env from .env.example"; fi

# ------------------------------------------------------------------------------
# الحاويات وقواعد البيانات
# ------------------------------------------------------------------------------
db-up:
	docker compose up -d db db_test mailpit

db-down:
	docker compose down

# ------------------------------------------------------------------------------
# الهجرات والبيانات التجريبية
# ------------------------------------------------------------------------------
migrate:
	uv run alembic upgrade head

seed:
	uv run python -m app.cli seed

# ------------------------------------------------------------------------------
# خادم التطوير
# ------------------------------------------------------------------------------
run:
	uv run uvicorn app.main:app --reload

# ------------------------------------------------------------------------------
# الاختبارات
# ------------------------------------------------------------------------------
test:
	uv run pytest

test-critical:
	uv run pytest -m critical

# ------------------------------------------------------------------------------
# التدقيق والأنواع
# ------------------------------------------------------------------------------
lint:
	uv run ruff check .
	uv run ruff format --check .
	@if [ -d app ]; then uv run mypy app; else echo "app/ directory does not exist yet (scheduled for P0.12); skipping mypy app."; fi

# ------------------------------------------------------------------------------
# فحص الأمان والثغرات
# ------------------------------------------------------------------------------
audit:
	uv run pip-audit

# ------------------------------------------------------------------------------
# فحص الجودة الموحد (بوابة ما قبل الدمج)
# ------------------------------------------------------------------------------
check: lint test
